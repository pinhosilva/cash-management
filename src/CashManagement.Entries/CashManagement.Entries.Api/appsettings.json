{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Entries": "Server=localhost;Database=CashManagementEntries;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "cash.management.entries.events"
  },
  "Jwt": {
    "Issuer": "cash-management",
    "Audience": "cash-management-entries"
  },
  "Outbox": {
    "PollIntervalSeconds": 2
  },
  "Idempotency": {
    "WindowHours": 24
  },
  "Features": {
    "Swagger": null,
    "DevTokenEndpoint": null,
    "AutoCreateSchema": null
  }
}
