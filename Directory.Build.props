<Project>

  <!--
    Configuração de build compartilhada por todos os projetos da solução.
    Trava framework, versão da linguagem e qualidade (ver TASKS.md T01, ARCHITECTURE.md §3/§9).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
